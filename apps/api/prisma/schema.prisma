// HashiNet's data model on PostgreSQL 18. Ported from the earlier Drizzle/MySQL schema in the
// build plan's M3; differences are deliberate and listed in that plan.
//
// Conventions: UUIDv7 keys generated by the database; timestamps are timestamptz in UTC (business
// days are computed in Africa/Dar_es_Salaam at query time); money is DECIMAL in TSH; snake_case
// tables and columns. Constraints Prisma cannot express (CHECKs) are in the baseline migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

/// Where a membership acts: HashiNet itself, or one business (ADR-0011).
enum MembershipScope {
  platform
  business

  @@map("membership_scope")
}

/// One ladder per scope (ADR-0011, 2). `admin`, `manager` and `operator` are the platform's;
/// the rest a business's. A CHECK keeps each role in its own scope.
enum MembershipRole {
  admin
  manager
  operator
  owner
  business_manager
  venue_manager
  venue_operator

  @@map("membership_role")
}

enum MembershipStatus {
  active
  removed

  @@map("membership_status")
}

/// How a session was signed in: the protection rule (ADR-0011, 9) reads it, not the person.
enum SignInMethod {
  email_code
  authenticator
  passkey
  recovery_code

  @@map("sign_in_method")
}

enum BusinessStatus {
  active
  closed

  @@map("business_status")
}

enum AuditCategory {
  change
  read
  auth

  @@map("audit_category")
}

enum AuditOutcome {
  success
  no_change
  failed
  denied

  @@map("audit_outcome")
}

enum VenueStatus {
  active
  inactive
  maintenance

  @@map("venue_status")
}

enum RouterStatus {
  online
  offline
  provisioning
  error

  @@map("router_status")
}

/// `pending_activation`: redeemed, but the router has not yet confirmed the hotspot user.
/// Nothing treats it as usable until the router read-back succeeds.
enum VoucherStatus {
  unused
  pending_activation
  active
  expired
  used
  refunded

  @@map("voucher_status")
}

enum SessionStatus {
  connected
  disconnected
  expired
  terminated

  @@map("session_status")
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  cancelled

  @@map("payment_status")
}

/// Provider-neutral: the mobile-money gateway, not the brand, is recorded.
enum PaymentProvider {
  cash
  mobile_money
  card
  manual

  @@map("payment_provider")
}

enum SmsStatus {
  sending
  sent
  delivered
  failed
  unconfirmed

  @@map("sms_status")
}

enum ThemePreference {
  light
  dark
  system

  @@map("theme_preference")
}

// Authentication: Better Auth's tables (ADR-0007).
// Model names are the ones Better Auth's Prisma adapter expects; only tables and columns are
// renamed. Ids are UUIDv7: generated by the application (advanced.database.generateId), with the
// database's `uuidv7()` as the default for any row written another way.
// HashiNet reads nothing here for authorization: that is `memberships`, through the session's
// active membership.

/// A person who can sign in. Email is lower-case (CHECK).
model User {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String   @db.VarChar(160)
  email            String   @unique @db.VarChar(255)
  emailVerified    Boolean  @default(false) @map("email_verified")
  image            String?
  /// E.164, as `+255...`; given when accepting an invitation, so HashiNet's team can call.
  phone            String?  @db.VarChar(20)
  twoFactorEnabled Boolean? @default(false) @map("two_factor_enabled")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  accounts    Account[]
  twofactors  TwoFactor[]
  passkeys    Passkey[]
  memberships Membership[]
  preference  UserPreference?
  codeBudget  SignInCodeBudget?

  @@map("users")
}

model Session {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  expiresAt          DateTime      @map("expires_at") @db.Timestamptz(3)
  token              String        @unique
  ipAddress          String?       @map("ip_address") @db.VarChar(45)
  userAgent          String?       @map("user_agent")
  userId             String        @map("user_id") @db.Uuid
  /// The membership this session acts as (ADR-0011, 7); null until one is chosen.
  activeMembershipId String?       @map("active_membership_id") @db.Uuid
  /// How this session signed in; an email code alone can reach only Account and security.
  signedInWith       SignInMethod? @map("signed_in_with")
  /// When this session last proved the person's protection (a passkey, an authenticator code or
  /// a recovery code). Changing protection needs proof from the last 2 hours, as sudo mode does.
  provedAt           DateTime?     @map("proved_at") @db.Timestamptz(3)
  /// Which factor gave that proof: each change accepts only some (ADR-0011, 9).
  provedWith         SignInMethod? @map("proved_with")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeMembership Membership? @relation(fields: [activeMembershipId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in methods. Passwordless: no row ever holds a password (ADR-0007).
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// One-time sign-in codes, stored hashed.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

/// Authenticator-app (TOTP) secrets and recovery codes (ADR-0011, 9).
model TwoFactor {
  id                      String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  secret                  String
  backupCodes             String    @map("backup_codes")
  userId                  String    @unique @map("user_id") @db.Uuid
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factors")
}

/// A passkey (the passkey plugin's table). It counts only with user verification, which sign-in
/// requires (ADR-0011, 9).
model Passkey {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String?   @db.VarChar(120)
  publicKey    String    @map("public_key")
  userId       String    @map("user_id") @db.Uuid
  credentialID String    @map("credential_id")
  counter      Int
  deviceType   String    @map("device_type") @db.VarChar(32)
  backedUp     Boolean   @map("backed_up")
  transports   String?
  aaguid       String?   @db.VarChar(36)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  /// When it last signed the person in or confirmed a change; written by HashiNet, not the library.
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

/// Sign-in rate-limit counters, shared by every API process.
model RateLimit {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

/// How many sign-in codes were sent to one person in the current window, whatever address
/// asked: the per-address limit Better Auth's per-IP limits cannot give.
model SignInCodeBudget {
  userId          String   @id @map("user_id") @db.Uuid
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  codesSent       Int      @map("codes_sent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sign_in_code_budgets")
}

// Tenancy and authorization (ADR-0011).

/// A business: the tenant. It owns its venues; its people are memberships in it.
model Business {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name                 String         @db.VarChar(160)
  /// One of Tanzania's 31 regions, chosen from the closed list in `@hashinet/types`.
  region               String         @db.VarChar(40)
  /// The area or street, as the owner types it.
  area                 String         @db.VarChar(160)
  status               BusinessStatus @default(active)
  /// Its own copy of HashiNet's fee terms, made when it was added (ADR-0013, 3): a change to the
  /// platform's terms reaches only businesses added after it. Rates in basis points (500 is 5%).
  feeRateBp            Int            @default(500) @map("fee_rate_bp")
  feeLowerRateBp       Int            @default(250) @map("fee_lower_rate_bp")
  feeLowerRateAboveTsh Int            @default(2000000) @map("fee_lower_rate_above_tsh")
  feeMinimumTsh        Int            @default(5000) @map("fee_minimum_tsh")
  /// What it may do (ADR-0014, 2), by its bills or held by hand; the API refuses selling while it is
  /// read-only or suspended.
  access               ServiceAccess  @default(enabled)
  /// When `access` took effect.
  accessSince          DateTime?      @map("access_since") @db.Timestamptz(3)
  /// Set by hand: `access` holds until `accessHeldUntil` (a business day; null until changed), then
  /// it follows its bills again. False: it follows its bills.
  accessHeld           Boolean        @default(false) @map("access_held")
  accessHeldUntil      DateTime?      @map("access_held_until") @db.Date
  /// When its bills pause selling, while in a grace period that ends in read-only; null otherwise.
  accessPausesOn       DateTime?      @map("access_pauses_on") @db.Date
  /// The way to pay its venues use unless they choose another; set whenever it has a way. The
  /// database refuses to remove it while it is the default.
  defaultPaymentWayId  String?        @map("default_payment_way_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Its logo's key in the brand store (ADR-0009); the file never enters this database.
  logoKey              String?        @map("logo_key") @db.VarChar(120)

  defaultPaymentWay PaymentWay?           @relation("BusinessDefaultWay", fields: [id, defaultPaymentWayId], references: [businessId, id], onDelete: NoAction, onUpdate: NoAction)
  paymentWays       PaymentWay[]          @relation("BusinessWays")
  accessChanges     ServiceAccessChange[]
  venues            Venue[]
  portal            BusinessPortal?
  memberships       Membership[]
  invitations       Invitation[]
  packages          Package[]
  auditLogs         AuditLog[]
  issues            Issue[]
  deviceBlocks      DeviceBlock[]
  invoices          Invoice[]
  billPayments      BillPayment[]

  @@map("businesses")
}

/// A person's role in one scope: the platform, or one business (ADR-0011, 7). At most one per
/// scope per person (a unique index with NULLS NOT DISTINCT). Authorization is read only from
/// the session's active membership.
model Membership {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  scope      MembershipScope
  /// Null exactly when the scope is the platform (CHECK).
  businessId String?          @map("business_id") @db.Uuid
  role       MembershipRole
  status     MembershipStatus @default(active)
  /// When a session last acted as this membership: a new session opens in the last one used.
  lastUsedAt DateTime?        @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  business         Business?             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  venues           MembershipVenue[]
  sessions         Session[]
  invitationsSent  Invitation[]
  issuesHeld       Issue[]               @relation("IssueHolder")
  issueEvents      IssueEvent[]          @relation("IssueActor")
  issueEventsTo    IssueEvent[]          @relation("IssueTo")
  recordedPayments Payment[]
  auditLogs        AuditLog[]
  refunds          Refund[]
  deviceBlocks     DeviceBlock[]
  billPayments     BillPayment[]
  paymentWays      PaymentWay[]
  accessChanges    ServiceAccessChange[]
  venueSites       VenueSite[]

  @@unique([userId, scope, businessId])
  @@index([businessId])
  @@map("memberships")
}

/// The venues a venue manager or venue operator works at; at least one for those roles.
model MembershipVenue {
  membershipId String @map("membership_id") @db.Uuid
  venueId      String @map("venue_id") @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  venue      Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([membershipId, venueId])
  @@index([venueId])
  @@map("membership_venues")
}

/// The only way in (ADR-0011): one role in one scope for one canonical email. Issuing creates
/// nothing else; accepting creates the person, the membership and, for a new business's owner,
/// the business and its first venue. The token travels in the link's fragment; only its digest
/// is kept.
model Invitation {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Lower-case (CHECK).
  email       String          @db.VarChar(255)
  scope       MembershipScope
  /// The business invited into; null for a platform role and for a new business's owner.
  businessId  String?         @map("business_id") @db.Uuid
  role        MembershipRole
  /// The venues of a venue manager or venue operator.
  venueIds    String[]        @default([]) @map("venue_ids") @db.Uuid
  tokenDigest String          @unique @map("token_digest") @db.VarChar(64)
  invitedById String?         @map("invited_by_id") @db.Uuid
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime?       @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  business  Business?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy Membership? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([businessId])
  @@map("invitations")
}

/// What a person sets for themselves, in every workspace: the theme.
model UserPreference {
  userId    String          @id @map("user_id") @db.Uuid
  theme     ThemePreference @default(system)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// HashiNet's billing settings, one row (`singleton`): the fee terms a new business starts with,
/// and where businesses pay HashiNet. Until the platform admin saves, the API answers with today's
/// terms and no payment details.
model BillingSetting {
  id                   String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singleton            Boolean  @unique @default(true)
  feeRateBp            Int      @map("fee_rate_bp")
  feeLowerRateBp       Int      @map("fee_lower_rate_bp")
  feeLowerRateAboveTsh Int      @map("fee_lower_rate_above_tsh")
  feeMinimumTsh        Int      @map("fee_minimum_tsh")
  /// What a venue's second and each further site open before paying costs, once.
  siteSlotTsh          Int      @default(10000) @map("site_slot_tsh")
  /// HashiNet's Lipa namba, and the name a payment to it shows.
  payMobileMoney       String?  @map("pay_mobile_money") @db.VarChar(40)
  payMobileMoneyName   String?  @map("pay_mobile_money_name") @db.VarChar(160)
  payBankName          String?  @map("pay_bank_name") @db.VarChar(80)
  payBankBranch        String?  @map("pay_bank_branch") @db.VarChar(80)
  payBankAccount       String?  @map("pay_bank_account") @db.VarChar(40)
  payBankSwift         String?  @map("pay_bank_swift") @db.VarChar(11)
  payAccountName       String   @map("pay_account_name") @db.VarChar(160)
  /// Who issues the invoices, as they print: the company's postal address, office, email,
  /// incorporation number and TIN.
  issuerPostal         String?  @map("issuer_postal") @db.VarChar(160)
  issuerOffice         String?  @map("issuer_office") @db.VarChar(160)
  issuerEmail          String?  @map("issuer_email") @db.VarChar(160)
  issuerRegistration   String?  @map("issuer_registration") @db.VarChar(40)
  issuerTin            String?  @map("issuer_tin") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("billing_settings")
}

/// The packages every new business starts with (ADR-0011, 10); a change reaches only businesses
/// added after it.
model PlatformDefaultPackage {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String   @db.VarChar(180)
  durationMinutes Int      @map("duration_minutes")
  deviceLimit     Int      @default(1) @map("device_limit")
  priceTsh        Decimal  @map("price_tsh") @db.Decimal(12, 2)
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_default_packages")
}

model Venue {
  id         String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String      @map("business_id") @db.Uuid
  name       String      @db.VarChar(180)
  /// One of Tanzania's 31 regions, chosen from the closed list in `@hashinet/types`.
  region     String      @db.VarChar(40)
  /// The area or street, as the owner types it, such as Mjimwema, Kigamboni.
  area       String      @db.VarChar(160)
  status     VenueStatus @default(active)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  members      MembershipVenue[]
  routers      Router[]
  issues       Issue[]
  packages     VenuePackage[]
  ownPackages  Package[]         @relation("VenueOwnPackages")
  /// The business's way to pay whoever sells here reads out; null uses the business's default.
  paymentWayId String?           @map("payment_way_id") @db.Uuid
  paymentWay   PaymentWay?       @relation(fields: [businessId, paymentWayId], references: [businessId, id], onDelete: NoAction, onUpdate: NoAction)
  onboarding   VenueOnboarding?
  portal       VenuePortal?
  vouchers     Voucher[]
  payments     Payment[]
  sessions     WifiSession[]
  refunds      Refund[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]
  venueSites   VenueSite[]
  siteSlots    SiteSlot[]

  @@unique([id, businessId])
  @@index([businessId])
  @@index([status])
  @@map("venues")
}

model Router {
  id                        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId                   String       @map("venue_id") @db.Uuid
  name                      String       @db.VarChar(160)
  model                     String?      @db.VarChar(160)
  identity                  String?      @db.VarChar(160)
  /// The router's address on its venue LAN, which the bootstrap assigns.
  ipAddress                 String       @map("ip_address") @db.VarChar(45)
  hotspotGatewayIp          String?      @map("hotspot_gateway_ip") @db.VarChar(45)
  macAddress                String?      @unique @map("mac_address") @db.VarChar(32)
  apiUsername               String?      @map("api_username") @db.VarChar(120)
  apiPasswordEncrypted      String?      @map("api_password_encrypted")
  enableHotspot             Boolean      @default(true) @map("enable_hotspot")
  hotspotName               String?      @map("hotspot_name") @db.VarChar(160)
  hotspotInterface          String?      @map("hotspot_interface") @db.VarChar(80)
  /// Network name customers see. Null leaves whatever the radio already broadcasts.
  ssid                      String?      @db.VarChar(32)
  networkRange              String?      @map("network_range") @db.VarChar(64)
  provisioningCommand       String?      @map("provisioning_command")
  provisionedAt             DateTime?    @map("provisioned_at") @db.Timestamptz(3)
  /// The router's address inside the management tunnel (ADR-0006), and so its management
  /// target. Null for a router the API reaches on its LAN.
  tunnelAddress             String?      @unique @map("tunnel_address") @db.VarChar(45)
  tunnelPublicKey           String?      @unique @map("tunnel_public_key") @db.VarChar(64)
  /// Kept so the bootstrap script can be regenerated without orphaning the pasted key.
  tunnelPrivateKeyEncrypted String?      @map("tunnel_private_key_encrypted")
  /// The secret its RADIUS requests are signed with (ADR-0015), made at setup; encrypted.
  radiusSecretEncrypted     String?      @map("radius_secret_encrypted")
  /// Cached capability probe (services/router-provision/probe.ts).
  rosVersion                String?      @map("ros_version") @db.VarChar(32)
  architecture              String?      @db.VarChar(32)
  capabilities              Json?
  lastProvisionReport       Json?        @map("last_provision_report")
  /// Set while a setup runs; a run this old with no finish was interrupted by a restart.
  setupStartedAt            DateTime?    @map("setup_started_at") @db.Timestamptz(3)
  setupPhase                String?      @map("setup_phase") @db.VarChar(20)
  /// The last finished setup: its phases and what blocked it.
  lastSetup                 Json?        @map("last_setup")
  lastSetupAt               DateTime?    @map("last_setup_at") @db.Timestamptz(3)
  lastSeenAt                DateTime?    @map("last_seen_at") @db.Timestamptz(3)
  /// Syncs and pushes that failed in a row; 0 once one works. Only the first of a run is audited.
  failedSyncs               Int          @default(0) @map("failed_syncs")
  /// Whether the router itself reaches the internet, from the live monitor's ping. A router that
  /// answers with no internet serves nobody, so it doesn't sell and its outage is given back.
  internetOk                Boolean      @default(true) @map("internet_ok")
  /// Pings that failed in a row: two mark it down, one good one marks it up, so a lost ping
  /// doesn't flap it.
  internetFails             Int          @default(0) @map("internet_fails")
  /// When it last reached the internet: an outage without internet began then.
  internetSeenAt            DateTime?    @map("internet_seen_at") @db.Timestamptz(3)
  uptimeSeconds             Int          @default(0) @map("uptime_seconds")
  connectedDevices          Int          @default(0) @map("connected_devices")
  status                    RouterStatus @default(offline)
  createdAt                 DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  issues     Issue[]
  venue      Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  sessions   WifiSession[]
  payments   Payment[]
  outages    RouterOutage[]
  admissions RadiusAdmission[]

  @@index([venueId])
  @@index([status])
  @@index([ipAddress])
  @@map("routers")
}

/// A business's package: its price in TSH, its time and its device limit. A business starts with
/// the platform's defaults (ADR-0011, 10); `venue_packages` says where each is sold.
model Package {
  id                    String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId            String   @map("business_id") @db.Uuid
  /// A venue's own package, sold only there (ADR-0011, 4); null for the business's, sold at every
  /// venue that hasn't stopped selling it.
  venueId               String?  @map("venue_id") @db.Uuid
  name                  String   @db.VarChar(180)
  description           String?
  /// Whole minutes.
  durationMinutes       Int      @map("duration_minutes")
  downloadSpeedMbps     Int      @map("download_speed_mbps")
  uploadSpeedMbps       Int?     @map("upload_speed_mbps")
  dataLimitGb           Int?     @map("data_limit_gb")
  deviceLimit           Int      @default(1) @map("device_limit")
  priceTsh              Decimal  @map("price_tsh") @db.Decimal(12, 2)
  features              String[] @default([])
  isActive              Boolean  @default(true) @map("is_active")
  throttledDownloadMbps Int?     @map("throttled_download_mbps")
  throttledUploadMbps   Int?     @map("throttled_upload_mbps")
  peakStartHour         Int?     @map("peak_start_hour")
  peakEndHour           Int?     @map("peak_end_hour")
  throttleAfterGb       Int?     @map("throttle_after_gb")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// A venue's own package is of that venue's business: the key holds both.
  ownVenue Venue?         @relation("VenueOwnPackages", fields: [venueId, businessId], references: [id, businessId], onDelete: Cascade)
  venues   VenuePackage[]
  vouchers Voucher[]
  payments Payment[]
  sessions WifiSession[]
  refunds  Refund[]

  @@index([businessId])
  @@index([isActive])
  @@index([priceTsh])
  @@map("packages")
}

/// Which packages a venue sells.
/// A venue's own setting for one of its business's packages (ADR-0011, 4): its own price, or not
/// sold there. A venue with no row follows the business: on sale, at the package's price.
model VenuePackage {
  venueId   String   @map("venue_id") @db.Uuid
  packageId String   @map("package_id") @db.Uuid
  /// The venue's own price; null follows the package's.
  priceTsh  Decimal? @map("price_tsh") @db.Decimal(12, 2)
  /// False: the venue doesn't sell it.
  onSale    Boolean  @default(true) @map("on_sale")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@id([venueId, packageId])
  @@index([packageId])
  @@map("venue_packages")
}

/// A guest device as the network saw it: one MAC address, created when a voucher is redeemed.
/// Not a person: one guest can be several devices, and a phone that randomises its MAC can be
/// a new device at each venue. The paying person is a customer (build plan M6).
model Device {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  macAddress    String    @unique @map("mac_address") @db.VarChar(32)
  lastIpAddress String?   @map("last_ip_address") @db.VarChar(45)
  deviceName    String?   @map("device_name") @db.VarChar(160)
  deviceType    String?   @map("device_type") @db.VarChar(40)
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastActiveAt  DateTime? @map("last_active_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  redeemedVouchers Voucher[]
  vouchers         VoucherDevice[]
  payments         Payment[]
  sessions         WifiSession[]

  blocks     DeviceBlock[]
  admissions RadiusAdmission[]

  @@map("devices")
}

model Voucher {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  packageId          String?       @map("package_id") @db.Uuid
  venueId            String?       @map("venue_id") @db.Uuid
  /// The device that redeemed it.
  redeemedByDeviceId String?       @map("redeemed_by_device_id") @db.Uuid
  /// The hotspot username and password. Upper-case (CHECK): RouterOS compares it
  /// case-sensitively, so guest input is upper-cased before lookup and login.
  /// `price_tsh` below is the price when the voucher was made, so a later price change never
  /// re-prices a sale.
  code               String        @unique @db.VarChar(80)
  status             VoucherStatus @default(unused)
  dataLimitGb        Int?          @map("data_limit_gb")
  dataUsedBytes      BigInt        @default(0) @map("data_used_bytes")
  /// Whole minutes; null inherits the package's.
  durationMinutes    Int?          @map("duration_minutes")
  /// Paid time given back after outages (router_outages): its end moved on by as much, and the
  /// router's limit for it raised by as much, every time it is pushed.
  givenBackMinutes   Int           @default(0) @map("given_back_minutes")
  priceTsh           Decimal       @map("price_tsh") @db.Decimal(12, 2)
  activatedAt        DateTime?     @map("activated_at") @db.Timestamptz(3)
  expiresAt          DateTime?     @map("expires_at") @db.Timestamptz(3)
  /// When it was refunded, while not used yet (ADR-0017, 7).
  refundedAt         DateTime?     @map("refunded_at") @db.Timestamptz(3)
  /// The switch PIN (ADR-0015, 4): an HMAC of it under a Docker secret and the voucher's id, made at
  /// the first sign-in and shown once; null before then, after a release, and once it expires.
  pinHmac            String?       @map("pin_hmac") @db.VarChar(64)
  /// Wrong PINs in a row: five wait 15 minutes (`pinWaitUntil`), ten lock it (`pinLockedAt`) until
  /// staff release it. A right PIN starts the count again.
  pinWrongTries      Int           @default(0) @map("pin_wrong_tries")
  pinWaitUntil       DateTime?     @map("pin_wait_until") @db.Timestamptz(3)
  pinLockedAt        DateTime?     @map("pin_locked_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  package          Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue            Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)
  redeemedByDevice Device?           @relation(fields: [redeemedByDeviceId], references: [id], onDelete: SetNull)
  devices          VoucherDevice[]
  payments         Payment[]
  sessions         WifiSession[]
  refund           Refund?
  admissions       RadiusAdmission[]

  @@index([status])
  @@index([packageId])
  @@index([venueId])
  @@index([redeemedByDeviceId])
  @@map("vouchers")
}

/// The devices a voucher has been redeemed on, which its package's device limit counts. Written
/// under a lock on the voucher, so two devices at once cannot both take the last place.
model VoucherDevice {
  voucherId String   @map("voucher_id") @db.Uuid
  deviceId  String   @map("device_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@id([voucherId, deviceId])
  @@index([deviceId])
  @@map("voucher_devices")
}

model Payment {
  id                  String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// The device that paid, when the payment was made on the portal. The paying person is the
  /// customer.
  deviceId            String?         @map("device_id") @db.Uuid
  voucherId           String?         @map("voucher_id") @db.Uuid
  packageId           String?         @map("package_id") @db.Uuid
  venueId             String?         @map("venue_id") @db.Uuid
  provider            PaymentProvider @default(manual)
  providerReference   String?         @map("provider_reference") @db.VarChar(160)
  phone               String?         @db.VarChar(32)
  amountTsh           Decimal         @map("amount_tsh") @db.Decimal(12, 2)
  status              PaymentStatus   @default(pending)
  paidAt              DateTime?       @map("paid_at") @db.Timestamptz(3)
  /// Tracked separately from `status`: money can be captured while the hotspot user still
  /// does not exist. Access waits on this, not on `status = paid`.
  routerProvisionedAt DateTime?       @map("router_provisioned_at") @db.Timestamptz(3)
  provisionError      String?         @map("provision_error")
  /// The paying device's portal session: only the hash, so the database cannot show a code.
  sessionSecretHash   String?         @map("session_secret_hash") @db.VarChar(64)
  idempotencyKey      String?         @unique @map("idempotency_key") @db.VarChar(30)
  customerId          String?         @map("customer_id") @db.Uuid
  routerId            String?         @map("router_id") @db.Uuid
  macAddress          String?         @map("mac_address") @db.VarChar(32)
  ipAddress           String?         @map("ip_address") @db.VarChar(45)
  /// Where the guest was going, for after they are online.
  destination         String?
  recordedById        String?         @map("recorded_by_id") @db.Uuid
  /// A mobile money sale at the counter: the way to pay that was read out, as it was then.
  paidThrough         String?         @map("paid_through") @db.VarChar(60)
  paidToNumber        String?         @map("paid_to_number") @db.VarChar(40)
  paidToName          String?         @map("paid_to_name") @db.VarChar(120)
  /// When the provider stops waiting for the guest to approve.
  expiresAt           DateTime?       @map("expires_at") @db.Timestamptz(3)
  lastCheckedAt       DateTime?       @map("last_checked_at") @db.Timestamptz(3)
  /// When the router reported the paying device online.
  signedInAt          DateTime?       @map("signed_in_at") @db.Timestamptz(3)
  metadata            Json?
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  device     Device?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  voucher    Voucher?    @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  package    Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  router     Router?     @relation(fields: [routerId], references: [id], onDelete: SetNull)
  recordedBy Membership? @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  sms        SmsMessage?
  refunds    Refund[]

  @@index([deviceId])
  @@index([voucherId])
  @@index([status])
  @@index([providerReference])
  @@index([customerId])
  @@map("payments")
}

/// Who pays: a mobile number, the only personal data, shown to admins and to managers for
/// their venues. A guest's device is a `Device`, and one customer can be several.
model Customer {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// E.164, as `+255...`.
  phone     String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  payments Payment[]

  @@map("customers")
}

/// A provider's event, once. The row is written in the transaction that acts on the event, so
/// a repeat or a race does nothing.
model WebhookEvent {
  provider   String   @db.VarChar(20)
  eventId    String   @map("event_id") @db.VarChar(120)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@id([provider, eventId])
  @@map("webhook_events")
}

/// A code sent to a phone. The text is not kept: it holds the code.
model SmsMessage {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId     String    @unique @map("payment_id") @db.Uuid
  status        SmsStatus @default(sending)
  jobId         String?   @map("job_id") @db.VarChar(120)
  messageId     String?   @map("message_id") @db.VarChar(120)
  failureReason String?   @map("failure_reason") @db.VarChar(255)
  /// Past this without a report, the screen says it was not confirmed.
  confirmBy     DateTime  @map("confirm_by") @db.Timestamptz(3)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([messageId])
  @@index([status])
  @@map("sms_messages")
}

model WifiSession {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deviceId          String?       @map("device_id") @db.Uuid
  voucherId         String?       @map("voucher_id") @db.Uuid
  packageId         String?       @map("package_id") @db.Uuid
  venueId           String?       @map("venue_id") @db.Uuid
  routerId          String?       @map("router_id") @db.Uuid
  macAddress        String        @map("mac_address") @db.VarChar(32)
  ipAddress         String?       @map("ip_address") @db.VarChar(45)
  deviceName        String?       @map("device_name") @db.VarChar(160)
  deviceType        String?       @map("device_type") @db.VarChar(40)
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?     @map("ended_at") @db.Timestamptz(3)
  durationSeconds   Int           @default(0) @map("duration_seconds")
  uploadBytes       BigInt        @default(0) @map("upload_bytes")
  downloadBytes     BigInt        @default(0) @map("download_bytes")
  uploadSpeedMbps   Decimal?      @map("upload_speed_mbps") @db.Decimal(8, 2)
  downloadSpeedMbps Decimal?      @map("download_speed_mbps") @db.Decimal(8, 2)
  signalStrengthDbm Int?          @map("signal_strength_dbm")
  terminationReason String?       @map("termination_reason") @db.VarChar(120)
  /// The router's RADIUS Acct-Session-Id: accounting for it lands on this row, once.
  acctSessionId     String?       @map("acct_session_id") @db.VarChar(64)
  isThrottled       Boolean       @default(false) @map("is_throttled")
  status            SessionStatus @default(connected)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  device  Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  voucher Voucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  venue   Venue?   @relation(fields: [venueId], references: [id], onDelete: SetNull)
  router  Router?  @relation(fields: [routerId], references: [id], onDelete: SetNull)

  @@unique([routerId, acctSessionId])
  @@index([deviceId])
  @@index([voucherId])
  @@index([routerId])
  @@index([status])
  @@index([startedAt])
  @@index([macAddress])
  @@index([venueId])
  @@map("wifi_sessions")
}

/// A device the API has just let in at a voucher's sign-in (ADR-0015): the router's next RADIUS
/// Access-Request for this address takes the place it holds, once, within a minute. A code reaches a
/// router only this way: a request with a code and no admission is refused.
model RadiusAdmission {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voucherId  String   @map("voucher_id") @db.Uuid
  routerId   String   @map("router_id") @db.Uuid
  deviceId   String   @map("device_id") @db.Uuid
  macAddress String   @map("mac_address") @db.VarChar(32)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  router  Router  @relation(fields: [routerId], references: [id], onDelete: Cascade)
  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([routerId, macAddress])
  @@index([voucherId])
  @@map("radius_admissions")
}

/// The portal page a guest sees first: the voucher page, or the buy page.
enum PortalStart {
  voucher
  buy

  @@map("portal_start")
}

/// What a new business's portal starts with (ADR-0009): its wording and the page it opens on; its
/// colours are the default theme's. One row (`singleton`, true by CHECK), so saving is an upsert.
model PortalSetting {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  singleton    Boolean     @unique @default(true)
  opensOn      PortalStart @default(voucher) @map("opens_on")
  showLogo     Boolean     @default(true) @map("show_logo")
  welcome      String      @db.VarChar(120)
  voucherText  String      @map("voucher_text") @db.VarChar(240)
  buyText      String      @map("buy_text") @db.VarChar(240)
  /// Where a guest with no voucher buys one in person; empty says "at the venue".
  whereToBuy   String      @map("where_to_buy") @db.VarChar(240)
  /// A number guests can call to find the seller, shown to anyone on the WiFi.
  contactPhone String?     @map("contact_phone") @db.VarChar(20)
  requireTerms Boolean     @default(true) @map("require_terms")
  terms        String      @db.VarChar(2000)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("portal_settings")
}

/// A pair of colours every business can choose for its portal; one is the default a new business
/// starts with (a partial unique index). A portal keeps its colours, not the theme: removing a theme
/// changes nobody's portal.
model PortalTheme {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name        String   @unique @db.VarChar(60)
  pageColor   String   @map("page_color") @db.VarChar(7)
  buttonColor String   @map("button_color") @db.VarChar(7)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("portal_themes")
}

/// What a business's new venues start with (ADR-0009): copied from the platform's when the
/// business is created, and into each venue's own when the venue is.
model BusinessPortal {
  businessId   String      @id @map("business_id") @db.Uuid
  pageColor    String      @map("page_color") @db.VarChar(7)
  buttonColor  String      @map("button_color") @db.VarChar(7)
  opensOn      PortalStart @default(voucher) @map("opens_on")
  showLogo     Boolean     @default(true) @map("show_logo")
  welcome      String      @db.VarChar(120)
  voucherText  String      @map("voucher_text") @db.VarChar(240)
  buyText      String      @map("buy_text") @db.VarChar(240)
  whereToBuy   String      @map("where_to_buy") @db.VarChar(240)
  contactPhone String?     @map("contact_phone") @db.VarChar(20)
  requireTerms Boolean     @default(true) @map("require_terms")
  terms        String      @db.VarChar(2000)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_portals")
}

/// What a venue's guests see (ADR-0009): its own copy, made from its business's when the venue is
/// created, and an optional logo of its own.
model VenuePortal {
  venueId      String      @id @map("venue_id") @db.Uuid
  pageColor    String      @map("page_color") @db.VarChar(7)
  buttonColor  String      @map("button_color") @db.VarChar(7)
  opensOn      PortalStart @default(voucher) @map("opens_on")
  showLogo     Boolean     @default(true) @map("show_logo")
  welcome      String      @db.VarChar(120)
  voucherText  String      @map("voucher_text") @db.VarChar(240)
  buyText      String      @map("buy_text") @db.VarChar(240)
  whereToBuy   String      @map("where_to_buy") @db.VarChar(240)
  contactPhone String?     @map("contact_phone") @db.VarChar(20)
  requireTerms Boolean     @default(true) @map("require_terms")
  terms        String      @db.VarChar(2000)
  /// A key in the brand store; the file itself never enters this database.
  logoKey      String?     @map("logo_key") @db.VarChar(120)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@map("venue_portals")
}

/// The audit log (ADR-0012): append-only, written in the change's transaction, scoped like
/// everything else. Labels are read when answering; the row holds ids. `change` is a bounded
/// before and after validated per action: never names, emails, codes, tokens or addresses.
model AuditLog {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Null for the system.
  actorMembershipId String?       @map("actor_membership_id") @db.Uuid
  actorUserId       String?       @map("actor_user_id") @db.Uuid
  businessId        String?       @map("business_id") @db.Uuid
  venueId           String?       @map("venue_id") @db.Uuid
  /// A typed action from the closed union in `@hashinet/types`, such as `package.price.set`.
  action            String        @db.VarChar(80)
  category          AuditCategory
  targetType        String        @map("target_type") @db.VarChar(40)
  targetId          String?       @map("target_id") @db.VarChar(80)
  outcome           AuditOutcome
  change            Json?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actorMembership Membership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)
  business        Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([venueId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum IssueKind {
  /// A router that has served stopped answering; it resolves when the router serves again.
  router_offline
  /// A venue's package: call the owner and confirm, get it paid, schedule the setup.
  venue_package
  /// A venue's setup: add the router, install it, set it up; it resolves when a guest gets online.
  venue_setup
  /// What a business owes HashiNet: its owner's alone, never claimed; it resolves once paid.
  bill_due
  /// For its managers: selling pauses, or has paused, until the owner pays (ADR-0014, 2). Never
  /// claimed; it resolves once the business sells again.
  selling_paused

  @@map("issue_kind")
}

enum IssueStatus {
  open
  resolved

  @@map("issue_status")
}

enum IssueAction {
  opened
  claimed
  released
  handed
  taken_over
  noted
  step
  resolved

  @@map("issue_action")
}

/// Something that needs someone (redesign-admin, Issues). Issues are kept per workspace: the
/// platform (`scope` platform, no business) and each business (`scope` business, its id) hold their
/// own, each claimed by one of its own people (ADR-0011, 11). At most one open issue per key in a
/// workspace (a partial unique index).
model Issue {
  id         String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope      MembershipScope
  businessId String?         @map("business_id") @db.Uuid
  kind       IssueKind
  /// What makes it one issue, such as `router:<id>`.
  key        String          @db.VarChar(120)
  status     IssueStatus     @default(open)
  venueId    String?         @map("venue_id") @db.Uuid
  routerId   String?         @map("router_id") @db.Uuid
  holderId   String?         @map("holder_id") @db.Uuid
  /// What took a router issue's router down when it opened: offline, no-internet or
  /// needs-attention (its `RouterCondition`), so the issue says it even after it closes.
  cause      String?         @db.VarChar(40)
  openedAt   DateTime        @default(now()) @map("opened_at") @db.Timestamptz(3)
  resolvedAt DateTime?       @map("resolved_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business?    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  venue    Venue?       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  router   Router?      @relation(fields: [routerId], references: [id], onDelete: SetNull)
  holder   Membership?  @relation("IssueHolder", fields: [holderId], references: [id], onDelete: SetNull)
  events   IssueEvent[]

  @@index([scope, businessId, status])
  @@map("issues")
}

/// What happened on an issue, in order, and who did it (null: HashiNet itself).
model IssueEvent {
  id      String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  issueId String      @map("issue_id") @db.Uuid
  at      DateTime    @default(now()) @db.Timestamptz(3)
  actorId String?     @map("actor_id") @db.Uuid
  action  IssueAction
  /// Who it was handed to.
  toId    String?     @map("to_id") @db.Uuid
  /// A reason or a note a person wrote, one line.
  note    String?     @db.VarChar(500)
  /// What a step or a resolution was, as bounded facts the web words (`IssueEventData`).
  data    Json?

  issue Issue       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor Membership? @relation("IssueActor", fields: [actorId], references: [id], onDelete: SetNull)
  to    Membership? @relation("IssueTo", fields: [toId], references: [id], onDelete: SetNull)

  @@index([issueId, at])
  @@map("issue_events")
}

/// How a venue's router comes (ADR-0013, 2): connect its own, install one, or launch with a line.
enum OnboardingPlan {
  connect
  install
  launch

  @@map("onboarding_plan")
}

/// A venue's way to serving guests (ADR-0013, 2): the owner's preference, the package the team
/// agreed on the call, its payment, the setup date, and when the first guest got online. The
/// issues it moves through keep who did each step.
model VenueOnboarding {
  venueId     String          @id @map("venue_id") @db.Uuid
  /// When the owner chose; with no plan, they asked to talk first. Null: not asked yet.
  preferredAt DateTime?       @map("preferred_at") @db.Timestamptz(3)
  preference  OnboardingPlan?
  /// What the team agreed on the call; its price is its lines.
  plan        OnboardingPlan?
  note        String?         @db.VarChar(1000)
  confirmedAt DateTime?       @map("confirmed_at") @db.Timestamptz(3)
  setupDate   DateTime?       @map("setup_date") @db.Date
  /// The first guest got online: the venue is set up.
  completedAt DateTime?       @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  venue Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  lines VenueOnboardingLine[]

  @@map("venue_onboardings")
}

/// What a venue's onboarding is charged for, one line each, all on HashiNet's bill: the
/// onboarding fee agreed for the business, and what the plan brings (ADR-0013, 2).
enum OnboardingLineKind {
  onboarding_fee
  mikrotik_router
  isp_router
  internet_line
  other

  @@map("onboarding_line_kind")
}

model VenueOnboardingLine {
  id          String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId     String             @map("venue_id") @db.Uuid
  position    Int
  kind        OnboardingLineKind
  /// What it is: a router's model, what the fee covers, what "other" is.
  description String?            @db.VarChar(160)
  amountTsh   Int                @map("amount_tsh")

  onboarding VenueOnboarding @relation(fields: [venueId], references: [venueId], onDelete: Cascade)

  @@unique([venueId, position])
  @@map("venue_onboarding_lines")
}

/// What a way to pay is: each asks for what a guest needs to pay it.
enum PaymentWayKind {
  lipa_namba
  mobile_number
  bank_account

  @@map("payment_way_kind")
}

/// Where guests pay a business by mobile money at its counters, as its owner or a business manager
/// keeps them (ADR-0017, 4). Each venue reads out the one it chose, or the business's default.
model PaymentWay {
  id         String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String         @map("business_id") @db.Uuid
  kind       PaymentWayKind
  /// Whose it is: a Lipa namba's provider (M-Pesa, CRDB), the mobile money network or
  /// the bank. Required but for a Lipa namba added before providers were asked (a CHECK holds it).
  provider   String?        @db.VarChar(60)
  /// The Lipa namba, mobile money number or account number.
  number     String         @db.VarChar(40)
  /// The name the payment shows to the guest, or the bank account's name.
  name       String         @db.VarChar(120)
  /// A bank account's branch, when the owner gives it.
  branch     String?        @db.VarChar(60)
  /// For the business's own people, such as "Lodge reception".
  label      String?        @db.VarChar(60)
  addedById  String?        @map("added_by_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  business  Business    @relation("BusinessWays", fields: [businessId], references: [id], onDelete: Cascade)
  addedBy   Membership? @relation(fields: [addedById], references: [id], onDelete: SetNull)
  defaultOf Business[]  @relation("BusinessDefaultWay")
  venues    Venue[]

  @@unique([businessId, id])
  @@map("payment_ways")
}

/// How a refund went back to the guest.
enum RefundMethod {
  cash
  mobile_money

  @@map("refund_method")
}

/// A voucher's price given back while it was not used yet, by an owner or a manager (ADR-0017, 7).
/// Its own line in Payments, counted on the day it was made (ADR-0017, 8); the voucher stops working.
model Refund {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  voucherId    String       @unique @map("voucher_id") @db.Uuid
  /// The sale it gives back.
  paymentId    String       @map("payment_id") @db.Uuid
  venueId      String?      @map("venue_id") @db.Uuid
  packageId    String?      @map("package_id") @db.Uuid
  amountTsh    Decimal      @map("amount_tsh") @db.Decimal(12, 2)
  method       RefundMethod
  /// For mobile money: the number it went to, and the reference from its message.
  phone        String?      @db.VarChar(32)
  reference    String?      @db.VarChar(80)
  reason       String?      @db.VarChar(200)
  refundedById String?      @map("refunded_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  voucher    Voucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  payment    Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  venue      Venue?      @relation(fields: [venueId], references: [id], onDelete: SetNull)
  package    Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  refundedBy Membership? @relation(fields: [refundedById], references: [id], onDelete: SetNull)

  @@index([venueId, createdAt])
  @@index([refundedById])
  @@map("refunds")
}

/// A device a business keeps off its WiFi, at every one of its venues and only there: blocking is
/// the business's own, as a device is seen across businesses.
model DeviceBlock {
  businessId  String   @map("business_id") @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  blockedById String?  @map("blocked_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business  Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  device    Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  blockedBy Membership? @relation(fields: [blockedById], references: [id], onDelete: SetNull)

  @@id([businessId, deviceId])
  @@index([deviceId])
  @@map("device_blocks")
}

enum OutageKind {
  offline
  no_internet

  @@map("outage_kind")
}

/// A time a set-up router stopped serving guests: unreachable or failing, or answering with no
/// internet. Once it serves again with its internet working, the paid time it took is given back
/// to the guests whose vouchers ran through it, once (`givenBackAt`).
model RouterOutage {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  routerId    String     @map("router_id") @db.Uuid
  kind        OutageKind
  /// When the router was last seen serving.
  startedAt   DateTime   @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime?  @map("ended_at") @db.Timestamptz(3)
  givenBackAt DateTime?  @map("given_back_at") @db.Timestamptz(3)

  router Router @relation(fields: [routerId], references: [id], onDelete: Cascade)

  @@index([routerId, startedAt])
  @@map("router_outages")
}

/// What a business owes HashiNet (ADR-0013): a month's fees, or a venue's onboarding.
enum InvoiceKind {
  monthly_fees
  onboarding
  /// An extra site a venue opens before paying, once (slice 5).
  site_slot

  @@map("invoice_kind")
}

/// An invoice, kept as issued: its lines are what was charged and are never recomputed. At most
/// one a business a month (`period`), and one live one a venue for its onboarding (a partial index
/// that skips cancelled ones).
model Invoice {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// INV-2026-11-0001: the month it was issued in, then a number from `invoice_number_seq`.
  number        String      @unique @db.VarChar(20)
  businessId    String      @map("business_id") @db.Uuid
  kind          InvoiceKind
  /// The month billed, as its first day in Dar es Salaam: monthly fees only.
  period        DateTime?   @db.Date
  /// The venue onboarded: an onboarding charge only. Kept if the venue goes; its line keeps the name.
  venueId       String?     @map("venue_id") @db.Uuid
  issuedAt      DateTime    @map("issued_at") @db.Timestamptz(3)
  dueOn         DateTime    @map("due_on") @db.Date
  totalTsh      Int         @map("total_tsh")
  /// When the owner was reminded on its due date, left unpaid: once.
  dueRemindedAt DateTime?   @map("due_reminded_at") @db.Timestamptz(3)
  /// Cancelled before anything was paid (its site removed, its package made free): kept with its
  /// number as history, never owed. Only an unpaid one is cancelled.
  cancelledAt   DateTime?   @map("cancelled_at") @db.Timestamptz(3)
  /// Why, as the owner's email said it.
  cancelReason  String?     @map("cancel_reason") @db.VarChar(240)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  venue       Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  lines       InvoiceLine[]
  allocations BillAllocation[]
  siteSlot    SiteSlot?

  @@unique([businessId, period])
  @@index([businessId, issuedAt])
  @@map("invoices")
}

/// A month whose invoices were issued in one complete pass: it is never priced again, so a business
/// that owed nothing on the 1st is not invoiced later from what changed since.
model InvoiceRun {
  /// The month, as its first day in Dar es Salaam.
  period      DateTime @id @db.Date
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)

  @@map("invoice_runs")
}

/// One line of an invoice: a venue's month (its net sales, the share a router served it, and the
/// minimum when that set the fee), or one line of a venue's onboarding package.
model InvoiceLine {
  id             String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  invoiceId      String              @map("invoice_id") @db.Uuid
  position       Int
  venueId        String?             @map("venue_id") @db.Uuid
  /// The venue's name for a month's fee, as it was; what an onboarding line is.
  label          String              @db.VarChar(160)
  onboardingKind OnboardingLineKind? @map("onboarding_kind")
  netSalesTsh    Int?                @map("net_sales_tsh")
  /// The share of the month a router served the venue, in basis points; null where no minimum applied.
  servedBp       Int?                @map("served_bp")
  /// The prorated minimum, when it was what the venue owed.
  minimumTsh     Int?                @map("minimum_tsh")
  amountTsh      Int                 @map("amount_tsh")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  venue   Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, position])
  @@map("invoice_lines")
}

/// How money reached HashiNet.
enum BillPaymentMethod {
  mobile_money
  bank_transfer
  cash

  @@map("bill_payment_method")
}

/// Money a business paid HashiNet, recorded by HashiNet's admin or a manager as it arrived
/// (ADR-0013, 6), and what it settled: the invoice it was recorded on, or the oldest first.
model BillPayment {
  id           String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId   String            @map("business_id") @db.Uuid
  amountTsh    Int               @map("amount_tsh")
  /// The day it arrived, in Dar es Salaam.
  receivedOn   DateTime          @map("received_on") @db.Date
  method       BillPaymentMethod
  reference    String?           @db.VarChar(80)
  /// Who recorded it; null for a payment carried over from before invoices.
  recordedById String?           @map("recorded_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  recordedBy  Membership?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  allocations BillAllocation[]

  @@index([businessId, receivedOn])
  @@map("bill_payments")
}

/// The part of a payment that settled one invoice.
model BillAllocation {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId String @map("payment_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid
  amountTsh Int    @map("amount_tsh")

  payment BillPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("bill_allocations")
}

/// What a business may do (ADR-0014, 2).
enum ServiceAccess {
  enabled
  /// Overdue: everything works, and selling pauses at the end of it unless it is paid.
  grace_period
  /// Signs in and looks; sells nothing new, and its packages and prices stay as they are.
  read_only
  /// Only by the platform admin, by hand: the portal takes no new vouchers either.
  suspended

  @@map("service_access")
}

/// Why a business's access changed (ADR-0014, 4).
enum ServiceAccessReason {
  payment_overdue
  payment_received
  payment_arranged
  policy_violation
  customer_request
  contract_ended
  issue_resolved
  other

  @@map("service_access_reason")
}

/// Each change to a business's access, as its owners were told: by its bills (`byId` null) or by
/// HashiNet's team by hand, with a note kept from the owners.
model ServiceAccessChange {
  id         String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  businessId String              @map("business_id") @db.Uuid
  access     ServiceAccess
  /// Whether it was set by hand, to hold; false when its bills set it.
  held       Boolean
  heldUntil  DateTime?           @map("held_until") @db.Date
  reason     ServiceAccessReason
  /// For HashiNet's team only: never emailed.
  note       String?             @db.VarChar(500)
  /// Sent to its owners with the change.
  message    String?             @db.VarChar(500)
  byId       String?             @map("by_id") @db.Uuid
  at         DateTime            @default(now()) @db.Timestamptz(3)

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  by       Membership? @relation(fields: [byId], references: [id], onDelete: SetNull)

  @@index([businessId, at])
  @@map("service_access_changes")
}

/// A site guests open before paying at a venue, such as its own website. The first comes with the
/// venue; each more opens once its slot is paid for (slice 5). Only open sites reach its routers.
model VenueSite {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  /// A host name only, such as mamaneemalodge.co.tz.
  host      String   @db.VarChar(253)
  /// Why it is open, for the business's people.
  note      String?  @db.VarChar(120)
  addedById String?  @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venue   Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  addedBy Membership? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([venueId, host])
  @@index([venueId, createdAt])
  @@map("venue_sites")
}

/// A venue's room for one more site open before paying, bought once through its own invoice, or
/// granted (no invoice) to a site open before slots existed. A paid slot stays with the venue
/// when its site is removed.
model SiteSlot {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  invoiceId String?  @unique @map("invoice_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  venue   Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([venueId])
  @@map("site_slots")
}
